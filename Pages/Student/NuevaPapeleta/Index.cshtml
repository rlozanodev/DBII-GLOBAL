@page
@model DBII_GLOBAL.Pages.Student.NuevaPapeletaModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nueva Papeleta";
}

<div class="container mt-5">
    <div class="modern-card p-4">
        <h3 class="mb-4">📋 Generar Nueva Papeleta</h3>
        
        <form method="post">
            <div class="mb-4">
                <label class="form-label">Selecciona la Asignatura</label>
                <select asp-for="Asignatura" class="custom-input" required>
                    <option value="">-- Selecciona --</option>
                    <option value="Química Orgánica">Química Orgánica</option>
                    <option value="Analítica">Analítica</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label">Materiales Disponibles (MongoDB)</label>
                <div class="material-list border rounded p-3" style="max-height: 250px; overflow-y: auto;">
                    @foreach (var item in Model.MaterialesDisponibles)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="MaterialesSeleccionados" value="@item.Nombre" id="item-@item.Id">
                            <label class="form-check-label" for="item-@item.Id">
                                @item.Nombre <span class="badge bg-secondary ms-2">@item.Tipo</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom w-100">Agendar Préstamo</button>
                <a asp-page="/Student/Dashboard/Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
            </div>
        </form>
    </div>
</div>