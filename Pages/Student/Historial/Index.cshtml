@page
@model DBII_GLOBAL.Pages.Student.HistorialModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Historial";
}

@section Styles { 
    <link rel="stylesheet" href="~/css/historial.css" asp-append-version="true" /> 
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-weight: 800;">Historial Completo</h2>
        <span class="badge status-pill bg-dark">Cassandra Archive</span>
    </div>

    <div class="modern-table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Asignatura / Profesor</th>
                    <th>Materiales</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Historial.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center p-5">
                            <span class="text-muted">No se encontraron registros en el histórico.</span>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Historial)
                {
                    <tr>
                        <td class="fw-bold">@item.IdPapeleta</td>
                        <td>@item.Fecha</td>
                        <td>
                            <div>@item.Asignatura</div>
                            <small class="text-muted">Prof: @item.Profesor</small>
                        </td>
                        <td>
                            <ul class="list-unstyled mb-0 small">
                                @foreach(var mat in item.MaterialesList) {
                                    <li>• @mat</li>
                                }
                            </ul>
                        </td>
                        <td>
                            <span class="status-pill @(item.EstadoFinal == "Entregada" ? "bg-success text-white" : "bg-warning text-dark")">
                                @item.EstadoFinal
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>