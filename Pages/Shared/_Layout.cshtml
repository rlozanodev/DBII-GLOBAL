<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab Químico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="navbar-container">
    <nav class="modern-navbar">
        <div class="nav-links">
            @if (User.Identity!.IsAuthenticated)
            {
                <a class="nav-item-link" asp-page="/Index">Inicio</a>
                @if (User.IsInRole("Alumno"))
                {
                    <a class="nav-item-link" asp-page="/Student/Historial/Index">Historial</a>
                    <a class="nav-item-link" asp-page="/Student/NuevaPapeleta/Index">Nueva Papeleta</a>
                }
                @if (User.IsInRole("Almacén"))
                {
                    <a class="nav-item-link" asp-page="/Personal/Inventario/Index">Inventario</a>
                }
                @if (User.IsInRole("Profesor"))
                {
                    <!--<a class="nav-item-link" asp-page="/Teaching/Dashboard/Index">Clases</a>-->
                }
                @if (User.IsInRole("Administrador"))
                {
                    <a class="nav-item-link" asp-page="/Administrator/Inventory/Index">Inventario</a>
                    <a class="nav-item-link" asp-page="/Administrator/Users/Index">Usuarios</a>
                    <a class="nav-item-link" asp-page="/Administrator/History/Index">Histórico</a>
                }
            }
        </div>

        <div class="nav-logo">
            <a asp-page="/Index" class="logo-text">
                <span class="icon">🧪</span> Lab<span class="bold">Química</span>
            </a>
        </div>

        <div class="nav-actions">
            <button onclick="toggleTheme()" class="theme-switch" id="theme-btn">
                <span id="theme-icon">🌙</span>
            </button>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="user-profile">
                    <span class="user-name">@User.Identity.Name</span>
                    <span class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
                <a class="btn-logout" asp-page="/Login/Logout">
                    Cerrar Sesión 
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                </a>
            }
            else
            {
                <!--<a class="btn-login" asp-page="/Login/Login">Sign in</a>
                <a class="btn-demo" href="#">Explorar ➔</a>-->
            }
        </div>
    </nav>
</header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="main-footer">
        <div class="container text-center">
            &copy; 2026 - Centro de Enseñanza Técnica Industrial - Persistencia Políglota (Mongo, Redis, Cassandra)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const currentTheme = html.getAttribute("data-theme");
            const newTheme = currentTheme === "dark" ? "light" : "dark";
            
            html.setAttribute("data-theme", newTheme);
            localStorage.setItem("theme", newTheme);
            updateIcon(newTheme);
        }

        function updateIcon(theme) {
            document.getElementById("theme-icon").innerText = theme === "dark" ? "☀️" : "🌙";
        }

        // Cargar preferencia al iniciar
        (function() {
            const savedTheme = localStorage.getItem("theme") || "light";
            document.documentElement.setAttribute("data-theme", savedTheme);
            updateIcon(savedTheme);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>