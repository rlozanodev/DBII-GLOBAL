@page
@model LoginModel
@{ Layout = "_Layout"; ViewData["Title"] = "Iniciar Sesión"; }
@section Styles { <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" /> }

<div class="login-container">
    <div class="modern-card">
        <div class="card-content">
            <div class="text-center mb-4">
                <h3 style="font-weight: 800; letter-spacing: -1px;">Bienvenido</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Ingresa tus datos para continuar</p>
            </div>

            <form method="post">
                <div class="form-group mb-4">
                    <label class="form-label">Registro Académico</label>
                    <input asp-for="Registro" class="custom-input" placeholder="Ej. 2021001" required autocomplete="off" />
                </div>
                
                <div class="form-group mb-4">
                    <label class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="custom-input" placeholder="••••••••" required />
                </div>

                @if (!string.IsNullOrEmpty(Model.Mensaje)) {
                    <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.85rem; border-radius: 10px;">
                        @Model.Mensaje
                    </div>
                }

                <button type="submit" class="btn-primary-custom w-100">Entrar al Laboratorio</button>
            </form>
        </div>
    </div>
</div>