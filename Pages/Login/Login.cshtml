@page
@model LoginModel
@{ Layout = "_Layout"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-4 card shadow-sm p-4">
        <h2 class="text-center mb-4">🧪 Lab Químico</h2>
        <form method="post">
            <div class="mb-3">
                <label>Registro (ID)</label>
                <input asp-for="Registro" class="form-control" placeholder="Ej. 2021001" required />
            </div>
            <div class="mb-3">
                <label>Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" required />
            </div>
            @if (!string.IsNullOrEmpty(Model.Mensaje)) {
                <div class="alert alert-danger p-2">@Model.Mensaje</div>
            }
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.DebugInfo))
{
    <div class="alert alert-warning mt-3" style="font-size: 0.8rem;">
        <strong>Detalle Técnico (Debug):</strong>
        <pre>@Model.DebugInfo</pre>
    </div>
}