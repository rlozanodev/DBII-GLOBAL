@page
@model DBII_GLOBAL.Pages.Administrator.GlobalHistoryModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Auditoría Histórica";
}

@section Styles {
    <link rel="stylesheet" href="~/css/historial.css" asp-append-version="true" />
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-weight: 800;">Auditoría de Registros</h2>
            <p class="text-muted small">Visualización completa de la persistencia en Cassandra</p>
        </div>
        <span class="badge bg-danger p-2 px-3 rounded-pill">Acceso Total</span>
    </div>

    <div class="modern-table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Alumno (Registro)</th>
                    <th>Asignatura</th>
                    <th>Materiales</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TodosLosRegistros.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center p-5 text-muted">
                            No existen registros históricos en el clúster de Cassandra.
                        </td>
                    </tr>
                }
                @foreach (var p in Model.TodosLosRegistros)
                {
                    <tr>
                        <td class="fw-bold">#@p.IdPapeleta</td>
                        <td>
                            <div>@p.NombreAlumno</div>
                            <small class="text-muted">@p.RegistroAlumno</small>
                        </td>
                        <td>@p.Asignatura</td>
                        <td>
                            <ul class="list-unstyled mb-0 small">
                                @foreach(var mat in p.MaterialesList) {
                                    <li><i class="bi bi-check2-circle text-success me-1"></i> @mat</li>
                                }
                            </ul>
                        </td>
                        <td>@p.Fecha</td>
                        <td>
                            <span class="status-pill bg-dark text-white">@p.EstadoFinal</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>