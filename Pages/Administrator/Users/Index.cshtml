@page
@model DBII_GLOBAL.Pages.Administrator.UserManagementModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/historial.css" asp-append-version="true" />
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-weight: 800;">Usuarios del Sistema</h2>
            <p class="text-muted small">Control de acceso y roles en MongoDB</p>
        </div>
        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
            + Nuevo Usuario
        </button>
    </div>

    <div class="modern-table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Registro / ID</th>
                    <th>Nombre Completo</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Usuarios)
                {
                    <tr>
                        <td class="fw-bold">@user.Registro</td>
                        <td>@user.Nombre</td>
                        <td>
                            <span class="status-pill @(user.Rol == "Administrador" ? "bg-dark text-white" : "bg-info text-white")">
                                @user.Rol
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn-action-edit" 
                                        onclick="prepararEdicionUsuario('@user.Id', '@user.Registro', '@user.Nombre', '@user.Rol')"
                                        data-bs-toggle="modal" data-bs-target="#modalEditarUsuario">
                                    <i class="bi bi-person-gear"></i>
                                </button>
                                <form asp-page-handler="Delete" asp-route-id="@user.Id" method="post" 
                                      onsubmit="return confirm('¿Eliminar a @user.Nombre?');">
                                    <button type="submit" class="btn-action-delete">
                                        <i class="bi bi-person-x-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-card border-0">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-bold">Configurar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-page-handler="Update" method="post">
                    <input type="hidden" id="editUserId" asp-for="NuevoUsuario.Id" />
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input asp-for="NuevoUsuario.Nombre" id="editUserNombre" class="custom-input" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Registro (ID)</label>
                        <input asp-for="NuevoUsuario.Registro" id="editUserRegistro" class="custom-input" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select asp-for="NuevoUsuario.Rol" id="editUserRol" class="custom-input">
                            <option value="Alumno">Alumno</option>
                            <option value="Almacén">Almacén</option>
                            <option value="Profesor">Profesor</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary-custom w-100 mt-3">Guardar Cambios</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalNuevoUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-card border-0">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-bold">Registrar Nuevo Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-page-handler="Add" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nombre Completo</label>
                        <input asp-for="NuevoUsuario.Nombre" class="custom-input" placeholder="Ej. Roberto Lozano Acosta" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Registro / ID</label>
                        <input asp-for="NuevoUsuario.Registro" class="custom-input" placeholder="Ej. 24110022" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña Inicial</label>
                        <input asp-for="NuevoUsuario.Password" type="password" class="custom-input" placeholder="••••••••" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol del Sistema</label>
                        <select asp-for="NuevoUsuario.Rol" class="custom-input" required>
                            <option value="">-- Seleccionar Rol --</option>
                            <option value="Alumno">Alumno</option>
                            <option value="Almacén">Almacén</option>
                            <option value="Profesor">Profesor</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary-custom w-100 mt-3">Guardar en MongoDB</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepararEdicionUsuario(id, registro, nombre, rol) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editUserRegistro').value = registro;
            document.getElementById('editUserNombre').value = nombre;
            document.getElementById('editUserRol').value = rol;
        }
    </script>
}